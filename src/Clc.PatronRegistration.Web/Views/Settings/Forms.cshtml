@model Clc.PatronRegistration.Web.Models.FormsViewModel
@{
    ViewData["Title"] = "Form codes";
    string OrganizationName(int organizationId) => Model.OrganizationNames.TryGetValue(organizationId, out var name)
        ? name
        : $"Organization {organizationId}";
}
<header class="settings-header">
    <h1>Form-code management</h1>
    <nav class="settings-navigation" aria-label="Form-code administration">
        <a asp-action="Index">Settings</a>
        <a asp-action="Audit">Audit history</a>
        <a asp-action="Forms" asp-route-libraryId="@Model.LibraryId" aria-current="page">Form codes</a>
        <a asp-action="Help">Help</a>
    </nav>
</header>
<p>The blank default form always exists and cannot be renamed or deleted. Named codes are immutable after creation.</p>
<div asp-validation-summary="All" class="validation-summary" role="alert"></div>

<table>
    <caption>System and library form-code metadata available to @Model.LibraryName <small>(Organization ID @Model.LibraryId)</small></caption>
    <thead>
        <tr>
            <th scope="col">Code</th>
            <th scope="col">Display name</th>
            <th scope="col">Description</th>
            <th scope="col">Owner</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>(blank)</code></td>
            <td>Default form</td>
            <td>Implicit default form</td>
            <td><span class="form-owner-name">@OrganizationName(Model.SystemOrganizationId)</span><small>Organization ID @Model.SystemOrganizationId</small></td>
            <td>Cannot be changed or deleted</td>
        </tr>
        @foreach (var form in Model.Forms)
        {
            <tr>
                <td><code>@form.FormCode</code></td>
                <td>@form.DisplayName</td>
                <td>@form.Description</td>
                <td><span class="form-owner-name">@OrganizationName(form.OrganizationId)</span><small>Organization ID @form.OrganizationId</small></td>
                <td>
                    @if (form.OrganizationId == Model.LibraryId || Model.IsGlobal)
                    {
                        <a asp-action="ConfirmDeleteForm" asp-route-organizationId="@form.OrganizationId" asp-route-formCode="@form.FormCode">Review deletion</a>
                        <details>
                            <summary>Edit metadata</summary>
                            <form asp-action="EditForm" asp-route-formCode="@form.FormCode" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="OrganizationId" value="@form.OrganizationId" />
                                <input type="hidden" name="FormCode" value="@form.FormCode" />
                                <label for="edit-name-@form.OrganizationId-@form.FormCode">Display name</label>
                                <input id="edit-name-@form.OrganizationId-@form.FormCode" name="DisplayName" value="@form.DisplayName" maxlength="200" required />
                                <label for="edit-description-@form.OrganizationId-@form.FormCode">Description</label>
                                <textarea id="edit-description-@form.OrganizationId-@form.FormCode" name="Description" maxlength="2000">@form.Description</textarea>
                                <button type="submit">Save metadata</button>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.LegacyForms.Count > 0)
{
    <section class="settings-panel" aria-labelledby="legacy-forms-heading">
        <h2 id="legacy-forms-heading">Legacy form codes awaiting metadata</h2>
        <p>These codes already have settings. Adopting one creates metadata only and does not copy or change setting rows.</p>
        @foreach (var legacy in Model.LegacyForms.Where(form => Model.IsGlobal || form.OwnerOrganizationId == Model.LibraryId))
        {
            <form asp-action="CreateForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrganizationId" value="@legacy.OwnerOrganizationId" />
                <input type="hidden" name="FormCode" value="@legacy.FormCode" />
                <strong><code>@legacy.FormCode</code></strong> — <span class="form-owner-name">inferred owner @OrganizationName(legacy.OwnerOrganizationId)</span> <small>(Organization ID @legacy.OwnerOrganizationId)</small>
                <label for="adopt-name-@legacy.OwnerOrganizationId-@legacy.FormCode">Display name</label>
                <input id="adopt-name-@legacy.OwnerOrganizationId-@legacy.FormCode" name="DisplayName" value="@legacy.FormCode" maxlength="200" required />
                <label for="adopt-description-@legacy.OwnerOrganizationId-@legacy.FormCode">Description</label>
                <textarea id="adopt-description-@legacy.OwnerOrganizationId-@legacy.FormCode" name="Description" maxlength="2000"></textarea>
                <button type="submit">Adopt metadata</button>
            </form>
        }
    </section>
}

@if (Model.LibraryId != Model.SystemOrganizationId)
{
    <section class="settings-panel" aria-labelledby="customize-heading">
        <h2 id="customize-heading">Customize a system form for this library</h2>
        @foreach (var form in Model.Forms.Where(item => item.OrganizationId == Model.SystemOrganizationId))
        {
            var local = Model.Forms.FirstOrDefault(item => item.OrganizationId == Model.LibraryId && item.FormCode.Equals(form.FormCode, StringComparison.OrdinalIgnoreCase));
            <form asp-action="CustomizeForm" asp-route-formCode="@form.FormCode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrganizationId" value="@Model.LibraryId" />
                <input type="hidden" name="FormCode" value="@form.FormCode" />
                <strong><code>@form.FormCode</code></strong>
                <label for="custom-name-@form.FormCode">Library display name</label>
                <input id="custom-name-@form.FormCode" name="DisplayName" value="@(local?.DisplayName ?? form.DisplayName)" maxlength="200" required />
                <label for="custom-description-@form.FormCode">Library description</label>
                <textarea id="custom-description-@form.FormCode" name="Description" maxlength="2000">@(local?.Description ?? form.Description)</textarea>
                <button type="submit">@(local is null ? "Create library customization" : "Update library customization")</button>
            </form>
        }
    </section>
}

<section class="settings-panel" aria-labelledby="create-form-heading">
    <h2 id="create-form-heading">Create a named form</h2>
    <form asp-action="CreateForm" method="post">
        @Html.AntiForgeryToken()
        <dl class="form-owner-display">
            <dt>Owning organization</dt>
            <dd>
                <span class="form-owner-name">@Model.LibraryName</span>
                <small>Organization ID @Model.LibraryId</small>
            </dd>
        </dl>
        <input id="form-owner-id" type="hidden" name="OrganizationId" value="@Model.LibraryId" />
        <label for="new-form-code">Immutable code</label>
        <input id="new-form-code" name="FormCode" maxlength="64" pattern="[A-Za-z0-9_-]+" required />
        <label for="new-form-name">Display name</label>
        <input id="new-form-name" name="DisplayName" maxlength="200" required />
        <label for="new-form-description">Description</label>
        <textarea id="new-form-description" name="Description" maxlength="2000"></textarea>
        <button type="submit">Create named form</button>
    </form>
</section>
<p><a asp-action="Index">Back to settings</a></p>

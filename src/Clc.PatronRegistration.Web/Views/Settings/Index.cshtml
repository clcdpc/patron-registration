@using Clc.PatronRegistration.Administration
@model Clc.PatronRegistration.Web.Models.SettingsIndexViewModel
@{
    ViewData["Title"] = "Registration settings";
    var groups = new[]
    {
        (SettingGroup.Alert, "Validation messages"),
        (SettingGroup.Label, "Field labels"),
        (SettingGroup.Require, "Required fields")
    };
    var settingsError = TempData["SettingsError"] as string;
    var settingsErrorGroup = TempData["SettingsErrorGroup"] as string;
    bool hasRestrictedDraftChanges = Model.HasRestrictedDraftChanges == true;
    bool canManageRestrictedDraft = Model.CanManageRestrictedDraft == true;
    bool canManageDraftLifecycle = !hasRestrictedDraftChanges || canManageRestrictedDraft;
}
<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />

<header class="settings-header">
    <div>
        <h1>Registration settings</h1>
        <p>Choose a library or branch and form, then review or change its registration settings. Settings not customized here continue to use the value provided by the next applicable level.</p>
    </div>
    <nav aria-label="Settings administration">
        <a asp-action="Audit">Audit history</a>
        <a asp-action="Forms" asp-route-libraryId="@Model.LibraryId">Form codes</a>
    </nav>
</header>
@if (!string.IsNullOrWhiteSpace(settingsError))
{
    <div class="validation-summary" role="alert">@settingsError</div>
}

<section class="settings-panel scope-panel" aria-labelledby="scope-heading">
    <h2 id="scope-heading">Settings for</h2>
    <form method="get" class="scope-form">
        <div>
            <label for="organization-scope">Library or branch</label>
            <select id="organization-scope" name="organizationId">
                @foreach (var scope in Model.Scopes)
                {
                    bool isSelectedScope = scope.OrganizationId == Model.OrganizationId;
                    <option value="@scope.OrganizationId" selected="@isSelectedScope">@scope.DisplayName</option>
                }
            </select>
        </div>
        <div>
            <label for="form-code-scope">Form</label>
            <select id="form-code-scope" name="formCode">
                @foreach (var form in Model.FormCodes)
                {
                    bool isSelectedForm = form.FormCode == Model.FormCode;
                    <option value="@form.FormCode" selected="@isSelectedForm">@form.DisplayName</option>
                }
            </select>
        </div>
        <button type="submit">Show settings</button>
    </form>
    <p class="scope-summary">
        <strong>@Model.OrganizationName</strong> · @(Model.FormCode.Length == 0 ? "Default form" : Model.FormCode)
    </p>
</section>

<section class="settings-panel draft-panel" aria-labelledby="draft-heading">
    <h2 id="draft-heading">Draft</h2>
    <div aria-live="polite">
        @if (Model.ActiveDraft is null)
        {
            <p>No shared draft is active.</p>
            <form asp-action="CreateDraft" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="organizationId" value="@Model.OrganizationId" />
                <input type="hidden" name="formCode" value="@Model.FormCode" />
                <button type="submit">Create shared draft</button>
            </form>
        }
        else
        {
            <p><strong>Shared draft #@Model.ActiveDraft.DraftId is active.</strong></p>
            @if (hasRestrictedDraftChanges && !canManageRestrictedDraft)
            {
                <p class="validation-summary" role="status">Restricted changes exist. A global administrator must commit, discard, preview, or remove those restricted changes.</p>
            }
            <div class="button-row">
            @if (canManageDraftLifecycle)
            {
                <form asp-action="CommitDraft" asp-route-draftId="@Model.ActiveDraft.DraftId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="organizationId" value="@Model.OrganizationId" />
                    <input type="hidden" name="formCode" value="@Model.FormCode" />
                    <button type="submit">Publish draft</button>
                </form>
                <form asp-action="DiscardDraft" asp-route-draftId="@Model.ActiveDraft.DraftId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="organizationId" value="@Model.OrganizationId" />
                    <input type="hidden" name="formCode" value="@Model.FormCode" />
                    <button type="submit" class="danger-button">Discard draft</button>
                </form>
                <form asp-action="CreatePreviewLink" asp-route-draftId="@Model.ActiveDraft.DraftId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
                    <input type="hidden" name="FormCode" value="@Model.FormCode" />
                    <label for="preview-operational-branch">Preview as branch</label>
                    <select id="preview-operational-branch" name="OperationalBranchId" required>
                        @if (Model.PreviewBranches.Count != 1)
                        {
                            <option value="">Select a branch</option>
                        }
                        @foreach (var branch in Model.PreviewBranches)
                        {
                            bool isSelectedOperationalBranch = Model.PreviewBranches.Count == 1;
                            <option value="@branch.OrganizationId" selected="@isSelectedOperationalBranch">@branch.DisplayName</option>
                        }
                    </select>
                    <label class="inline-check"><input type="checkbox" name="AllowLiveSubmission" value="true" /> Allow this preview to create real patron records</label>
                    <button type="submit">Create preview link</button>
                </form>
            }
            </div>
            @if (Model.PreviewLinks.Count > 0)
            {
                <details class="preview-history"><summary>Preview links (@Model.PreviewLinks.Count)</summary>
                <ul class="preview-links">
                    @foreach (var link in Model.PreviewLinks)
                    {
                        var operationalBranch = Model.PreviewBranches.FirstOrDefault(branch => branch.OrganizationId == link.OperationalBranchId);
                        bool allowsLiveSubmission = link.AllowLiveSubmission == true;
                        bool isRevoked = link.RevokedAtUtc.HasValue;
                        <li>
                            Link #@link.PreviewLinkId — @(operationalBranch?.DisplayName ?? $"branch {link.OperationalBranchId}") — @(isRevoked ? "Revoked" : allowsLiveSubmission ? "Active live preview" : "Active safe preview")
                            @if (!isRevoked && canManageDraftLifecycle)
                            {
                                <form asp-action="ReplacePreviewLinkMode" asp-route-previewLinkId="@link.PreviewLinkId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="allowLiveSubmission" value="@(!allowsLiveSubmission)" />
                                    <button type="submit">Replace with @(allowsLiveSubmission ? "safe" : "live") link</button>
                                    <small>Changing mode revokes this URL and displays a new URL once.</small>
                                </form>
                                <form asp-action="RevokePreviewLink" asp-route-previewLinkId="@link.PreviewLinkId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">Revoke link</button>
                                </form>
                            }
                        </li>
                    }
                </ul></details>
            }
        }
    </div>
</section>

<section class="settings-search" aria-labelledby="search-label">
    <label id="search-label" for="setting-search">Search settings</label>
    <input id="setting-search" type="search" autocomplete="off" placeholder="Search by setting name or description" />
    <p id="search-status" aria-live="polite"></p>
</section>

<form asp-action="DirectSave" method="post" id="settings-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
    <input type="hidden" name="FormCode" value="@Model.FormCode" />
    <input type="hidden" name="ExpectedVersion" value="@Model.ScopeVersion" />

    <section aria-labelledby="ordinary-heading">
        <h2 id="ordinary-heading">Settings</h2>
        @foreach (var category in SettingCategoryPresentation.Ordered)
        {
            var rows = Model.Settings.Where(row => row.Definition.Group == SettingGroup.Ordinary && row.Definition.Category == category)
                .OrderBy(row => row.Definition.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
            bool categoryOpen = rows.Any(row => row.DraftOperation is not null);
            <details class="setting-category" open="@categoryOpen">
                <summary>@category.DisplayName() <span>(@rows.Count)</span></summary>
                <div class="settings-list">
                @foreach (var row in rows) { <partial name="_SettingRow" model="row" /> }
                </div>
            </details>
        }
    </section>

    @foreach (var group in groups)
    {
        var rows = Model.Settings.Where(row => row.Definition.Group == group.Item1).ToList();
        bool isDynamicGroupOpen = rows.Any(row => row.DraftOperation is not null) ||
            string.Equals(group.Item1.ToString(), settingsErrorGroup, StringComparison.OrdinalIgnoreCase);
        <details class="dynamic-settings" open="@isDynamicGroupOpen">
            <summary>@group.Item2 <span>(@rows.Count)</span></summary>
            @if (group.Item1 == SettingGroup.Alert)
            {
                <p class="group-introduction">These messages are saved for future use but are not currently shown on registration forms.</p>
            }
            <div class="settings-list">
                @foreach (var row in rows)
                {
                    <partial name="_SettingRow" model="row" />
                }
            </div>
        </details>
    }

    <div class="settings-actions">
        <button type="submit">Review and save now</button>
        @if (Model.ActiveDraft is not null)
        {
            <button type="submit"
                    formaction="@Url.Action("SaveDraft", new { draftId = Model.ActiveDraft.DraftId })"
                    data-submit-kind="draft">
                Save changes to draft
            </button>
        }
    </div>
</form>

<dialog id="save-confirm" aria-labelledby="save-confirm-title">
    <h2 id="save-confirm-title">Review changes</h2>
    <p>Target: <strong>@Model.OrganizationName</strong>; form: <strong>@(Model.FormCode.Length == 0 ? "Default form" : Model.FormCode)</strong>.</p>
    <ul></ul>
    <div class="button-row">
        <button id="confirm-save" type="button">Save changes</button>
        <button id="cancel-save" type="button">Cancel</button>
    </div>
</dialog>

<script src="~/js/settings.js"></script>

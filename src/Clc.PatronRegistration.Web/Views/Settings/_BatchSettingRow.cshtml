@using Clc.PatronRegistration.Administration
@model Clc.PatronRegistration.Web.Models.SettingRowViewModel
@{
    var definition = Model.Definition;
    var resolution = Model.Resolution;
    var token = Model.Token;
    var isRequired = definition.Group == SettingGroup.Require;
    var columnHeadingPrefix = isRequired ? "required-fields" : "field-labels";
    var baselineOperation = Model.DraftOperation switch
    {
        DraftOperation.Upsert => "Upsert",
        DraftOperation.RemoveOverride => "RemoveOverride",
        _ => resolution.OwnsOverride ? "Upsert" : "RemoveOverride"
    };
    var baselineMode = baselineOperation == "Upsert" ? "customize" : "inherit";
    var customValue = Model.DraftOperation == DraftOperation.Upsert ? Model.DraftValue : resolution.OwnsOverride ? resolution.CurrentOverrideValue : resolution.EffectiveValue;
    var editorValue = Clc.PatronRegistration.Web.Models.SettingEditorDefaults.ValueFor(definition, customValue);
    var effectiveValue = isRequired
        ? bool.TryParse(resolution.EffectiveValue, out var required) ? required ? "Required" : "Optional" : "Not configured"
        : resolution.SourceOrganizationId.HasValue ? resolution.EffectiveValue ?? "Blank" : "Not configured";
    var source = resolution.OwnsOverride ? "Customized here" : resolution.SourceOrganizationId.HasValue ? Model.SourceDescription : "Not configured";
    var liveReviewSummary = !resolution.SourceOrganizationId.HasValue
        ? "not configured"
        : resolution.OwnsOverride ? effectiveValue : $"{effectiveValue} · inherited from {Model.SourceDescription}";
    var draftSummary = Model.DraftOperation switch
    {
        DraftOperation.Upsert => SettingValuePresentation.FriendlyValue(definition, Model.DraftValue, true),
        DraftOperation.RemoveOverride => Model.HasInheritedValue ? "Use inherited value" : "No value configured",
        _ => string.Empty
    };
    var searchText = $"{definition.DisplayName} {definition.Key} {definition.Description} {effectiveValue}".ToLowerInvariant();
    var settingsError = ViewData["SettingsError"] as string;
    var settingsErrorKey = ViewData["SettingsErrorKey"] as string;
    var validationError = string.Equals(definition.Key, settingsErrorKey, StringComparison.OrdinalIgnoreCase)
        ? settingsError
        : null;
    var validationErrorId = string.IsNullOrWhiteSpace(validationError) ? null : $"{token}-validation-error";
}
<tr class="setting-row batch-setting-row"
    data-search="@searchText"
    data-display-name="@definition.DisplayName"
    data-setting-key="@definition.Key"
    data-sensitive="false"
    data-draft-change="@Model.DraftOperation.HasValue.ToString().ToLowerInvariant()"
    data-customized-here="@resolution.OwnsOverride.ToString().ToLowerInvariant()"
    data-value-type="@definition.ValueType.ToString().ToLowerInvariant()"
    data-presentation-state="@(Model.DraftOperation.HasValue ? "draftchange" : resolution.OwnsOverride ? "customized" : resolution.SourceOrganizationId.HasValue ? "inherited" : "notset")"
    data-live-state="@(resolution.OwnsOverride ? "customized" : resolution.SourceOrganizationId.HasValue ? "inherited" : "notset")"
    data-live-summary="@liveReviewSummary"
    data-inherited-summary="@Clc.PatronRegistration.Web.Models.SettingValuePresentation.FriendlyValue(definition, Model.InheritedValue, Model.HasInheritedValue)"
    data-inherited-source="@(Model.InheritedSourceDescription ?? string.Empty)"
    data-has-inherited="@Model.HasInheritedValue.ToString().ToLowerInvariant()"
    data-baseline-mode="@baselineMode"
    data-baseline-value="@editorValue">
    <td class="batch-setting-name" headers="batch-@columnHeadingPrefix-field"><strong>@definition.DisplayName.Replace("Require ", "", StringComparison.OrdinalIgnoreCase)</strong><small>@definition.Description</small></td>
    <td class="batch-effective" headers="batch-@columnHeadingPrefix-effective">
        <span class="batch-effective-summary">@effectiveValue</span>
        <small class="batch-effective-source">@source</small>
        @if (Model.DraftOperation.HasValue)
        {
            <small class="batch-draft-status">Shared draft: @draftSummary</small>
        }
        <small class="batch-browser-status" role="status" aria-live="polite"></small>
    </td>
    <td class="batch-scope" headers="batch-@columnHeadingPrefix-scope">
        @if (validationErrorId is not null)
        {
            <p id="@validationErrorId" class="setting-validation-error" role="alert">@validationError</p>
        }
        <input class="change-index" type="hidden" name="Changes.Index" value="@token" disabled />
        <input class="change-key" type="hidden" name="Changes[@token].Key" value="@definition.Key" disabled />
        <input class="operation" type="hidden" name="Changes[@token].Operation" value="@baselineOperation" disabled />
        <input class="setting-value-binding" type="hidden" name="Changes[@token].Value" value="@editorValue" disabled />
        <fieldset class="setting-mode-group batch-mode-group" aria-describedby="@validationErrorId">
            <legend class="visually-hidden">At this scope for @definition.DisplayName</legend>
            @if (isRequired)
            {
                var inheritedBoolean = Model.HasInheritedValue && bool.TryParse(Model.InheritedValue, out var parsed) ? parsed ? "Yes" : "No" : "Not configured";
                <label><input class="setting-mode" type="radio" name="@token-mode" value="inherit" data-mode="inherit" checked="@(baselineMode == "inherit")" /> Inherit — @inheritedBoolean <small>@(Model.HasInheritedValue ? $"from {Model.InheritedSourceDescription ?? "the inherited scope"}" : "not configured")</small></label>
                <label><input class="setting-mode" type="radio" name="@token-mode" value="true" data-mode="customize" data-custom-value="true" checked="@(baselineMode == "customize" && (editorValue ?? string.Empty).Equals("true", StringComparison.OrdinalIgnoreCase))" /> Required</label>
                <label><input class="setting-mode" type="radio" name="@token-mode" value="false" data-mode="customize" data-custom-value="false" checked="@(baselineMode == "customize" && (editorValue ?? string.Empty).Equals("false", StringComparison.OrdinalIgnoreCase))" /> Optional</label>
            }
            else
            {
                <label><input class="setting-mode" type="radio" name="@token-mode" value="inherit" data-mode="inherit" checked="@(baselineMode == "inherit")" /> Inherit</label>
                <label><input class="setting-mode" type="radio" name="@token-mode" value="customize" data-mode="customize" checked="@(baselineMode == "customize")" /> Customize here</label>
                <label class="batch-label-input"><span class="visually-hidden">Custom label</span><input class="setting-value" type="text" value="@editorValue" maxlength="200" aria-describedby="@validationErrorId" /></label>
            }
        </fieldset>
    </td>
</tr>

@using Clc.PatronRegistration.Administration
@model Clc.PatronRegistration.Web.Models.SettingRowViewModel
@{
    var definition = Model.Definition;
    var resolution = Model.Resolution;
    var token = Model.Token;
    var inputId = $"{token}-value";
    var operationId = $"{token}-operation";
    bool isImage = definition.ValueType == SettingValueType.Image;
    bool hasDraftOperation = Model.DraftOperation.HasValue;
    bool isRemoveOverride = Model.DraftOperation == DraftOperation.RemoveOverride;
    bool isDraftUpsert = Model.DraftOperation == DraftOperation.Upsert;
    var editorValue = definition.IsSensitive ? string.Empty : isDraftUpsert
        ? Model.DraftValue
        : resolution.OwnsOverride ? resolution.CurrentOverrideValue : resolution.EffectiveValue;
    editorValue = Clc.PatronRegistration.Web.Models.SettingEditorDefaults.ValueFor(definition, editorValue);
    var safeEffective = definition.IsSensitive ? string.Empty : resolution.EffectiveValue;
    var searchText = $"{definition.DisplayName} {definition.Key} {definition.Description} {safeEffective}".ToLowerInvariant();
    var presentation = Clc.PatronRegistration.Web.Models.SettingValuePresentation.ForRow(Model);
    var imageHasValue = Model.EffectiveAsset is not null || Model.EffectiveAssetMissing;
    var imageHasStagedValue = Model.StagedAsset is not null || Model.StagedAssetMissing;
    var imageSummary = !isImage
        ? presentation.Value
        : hasDraftOperation
            ? isRemoveOverride
                ? Model.HasInheritedValue ? "Use inherited image" : "Remove image"
                : Model.StagedAsset?.FileName ?? (Model.StagedAssetMissing ? "Missing uploaded image" : "No image configured")
            : Model.EffectiveAsset?.FileName ?? (Model.EffectiveAssetMissing ? "Missing uploaded image" : "No image configured");
    var collapsedValue = hasDraftOperation && !isImage ? $"Draft: {imageSummary}" : imageSummary;
    bool isNotSet = presentation.State == SettingPresentationState.NotSet;
    bool canRemoveOverride = resolution.OwnsOverride;
    var inheritanceMessage = Clc.PatronRegistration.Web.Models.SettingInheritancePresentation.MessageFor(Model);
    var imageActionLabel = imageHasValue || imageHasStagedValue ? "Replace image" : "Upload image";
    var imageSource = Model.EffectiveAsset is null
        ? Model.EffectiveAssetMissing ? "Missing uploaded image" : "No image configured"
        : resolution.OwnsOverride ? "Customized" : $"Inherited from {Model.SourceDescription}";
}
<details class="setting-row"
         data-search="@searchText"
         data-display-name="@definition.DisplayName"
         data-setting-key="@definition.Key"
         data-old-value="@(definition.IsSensitive ? "••••••••" : definition.ValueType == SettingValueType.Image ? presentation.CurrentValue : resolution.EffectiveValue)"
         data-sensitive="@definition.IsSensitive.ToString().ToLowerInvariant()"
         data-server-operation="@(Model.DraftOperation?.ToString() ?? string.Empty)"
         data-draft-change="@hasDraftOperation.ToString().ToLowerInvariant()"
         data-applied-operation="@(isRemoveOverride ? "RemoveOverride" : "Upsert")"
         data-value-type="@definition.ValueType.ToString().ToLowerInvariant()"
         data-presentation-state="@presentation.State.ToString().ToLowerInvariant()"
         data-image-has-inherited="@Model.HasInheritedValue.ToString().ToLowerInvariant()"
         data-image-inherited-preview-url="@(Model.InheritedAsset?.PreviewUrl ?? string.Empty)"
         data-image-inherited-file-name="@(Model.InheritedAsset?.FileName ?? string.Empty)">
    <input class="change-index" type="hidden" name="Changes.Index" value="@token" disabled />
    <input class="change-key" type="hidden" name="Changes[@token].Key" value="@definition.Key" disabled />
    <input id="@operationId" class="operation" type="hidden" name="Changes[@token].Operation"
           value="@(isRemoveOverride ? "RemoveOverride" : "Upsert")" disabled />

    <summary>
        <span class="setting-summary-content">
            <span class="setting-name">@definition.DisplayName</span>
            <span class="summary-value" title="@collapsedValue">@collapsedValue</span>
            <span class="setting-status">@(isImage && hasDraftOperation ? "Shared draft" : isImage ? imageSource : presentation.Status)</span>
        </span>
    </summary>
    <div class="setting-content">
    <p>@definition.Description</p>
    <dl class="setting-source">
        <div>
            <dt>Current value</dt>
            <dd>@presentation.CurrentValue</dd>
        </div>
        <div>
            <dt>Comes from</dt>
            <dd>@(isNotSet ? "No value configured" : Model.SourceDescription)</dd>
        </div>
        <div>
            <dt>Status</dt>
            <dd>@(isNotSet ? "Not configured at the system, library, or branch level" : presentation.Status)</dd>
        </div>
        @if (hasDraftOperation && !isImage)
        {
            <div>
                <dt>Draft change</dt>
                <dd>@(isRemoveOverride ? "Use inherited value" : isDraftUpsert && definition.IsSensitive ? "Set a hidden value" : $"Set “{Model.DraftValue}”")</dd>
            </div>
        }
    </dl>

    @if (isImage)
    {
        <div class="image-setting" aria-labelledby="@inputId-label">
            <span id="@inputId-label" class="visually-hidden">@definition.DisplayName image controls</span>
            <div class="image-card image-current" data-image-current>
                <strong>Current</strong>
                @if (Model.EffectiveAsset is not null)
                {
                    <img class="setting-image-preview" src="@Model.EffectiveAsset.PreviewUrl" alt="Current header image" />
                    <small>@Model.EffectiveAsset.FileName</small>
                    <span class="image-source-status">@imageSource</span>
                }
                else if (Model.EffectiveAssetMissing)
                {
                    <p class="setting-missing-asset" role="status">The configured uploaded image is missing.</p>
                    <span class="image-source-status">@imageSource</span>
                }
                else
                {
                    <p>No image configured.</p>
                }
            </div>

            @if (hasDraftOperation)
            {
                <div class="image-card image-draft" data-image-draft>
                    <strong>Shared draft</strong>
                    @if (isDraftUpsert && Model.StagedAsset is not null)
                    {
                        <img class="setting-image-preview" src="@Model.StagedAsset.PreviewUrl" alt="Shared draft header image" />
                        <small>@Model.StagedAsset.FileName</small>
                        <span>Replace with this uploaded image.</span>
                    }
                    else if (isDraftUpsert && Model.StagedAssetMissing)
                    {
                        <p class="setting-missing-asset" role="status">The staged uploaded image is missing.</p>
                    }
                    else if (Model.StagedAsset is not null)
                    {
                        <img class="setting-image-preview" src="@Model.StagedAsset.PreviewUrl" alt="Inherited shared draft header image" />
                        <small>@Model.StagedAsset.FileName</small>
                        <span>Use inherited image.</span>
                    }
                    else
                    {
                        <p>No image will be configured.</p>
                        <span>@(Model.HasInheritedValue ? "Use inherited image." : "Remove image.")</span>
                    }
                </div>
            }

            <div class="image-card image-pending image-browser-pending" data-image-pending hidden>
                <strong class="image-pending-heading">Unsaved replacement</strong>
                <img class="setting-image-preview image-pending-preview" alt="Unsaved header image change" />
                <small class="image-pending-file-name"></small>
                <p class="image-upload-status" role="status" aria-live="polite"></p>
                <div class="image-pending-actions">
                    <button type="button" class="image-choose-another">Choose another image</button>
                    <button type="button" class="image-undo-pending">Undo replacement</button>
                </div>
            </div>

            <div class="image-actions">
                <button type="button" class="image-upload-trigger">@imageActionLabel</button>
                <input id="@inputId-file" class="image-file" type="file" accept="image/png,image/jpeg,image/webp"
                       aria-label="Choose a header image"
                       data-upload-url="@Url.Action("UploadHeaderImageAsset", "Settings")" />
                @if (canRemoveOverride)
                {
                    <button type="button" class="image-inherit-action" hidden="@isRemoveOverride">@(Model.HasInheritedValue ? "Use inherited image" : "Remove image")</button>
                }
            </div>
            <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="hidden" value="@editorValue" disabled />
            <small>PNG, JPEG, or WebP only; maximum size 2 MB. The image is uploaded when selected, then saved with the page changes.</small>
        </div>
    }
    else
    {
        <div class="setting-editor">
        <div class="value-editor" hidden>
            <label for="@inputId">Value</label>
            @if (definition.ValueType == SettingValueType.Boolean)
            {
                bool isTrueValue = editorValue.Equals("true", StringComparison.OrdinalIgnoreCase);
                bool isFalseValue = editorValue.Equals("false", StringComparison.OrdinalIgnoreCase);
                <select id="@inputId" class="setting-value" name="Changes[@token].Value" disabled>
                    <option value="true" selected="@isTrueValue">Yes</option>
                    <option value="false" selected="@isFalseValue">No</option>
                </select>
            }
            else if (definition.ValueType is SettingValueType.Integer or SettingValueType.NullableInteger or SettingValueType.Decimal)
            {
                <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="number" step="@(definition.ValueType == SettingValueType.Decimal ? "any" : "1")" value="@editorValue" disabled />
            }
            else if (definition.ValueType is SettingValueType.Date or SettingValueType.NullableDate)
            {
                <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="date" value="@editorValue" disabled />
            }
            else if (definition.ValueType == SettingValueType.EmailAddress)
            {
                <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="email" value="@editorValue" disabled />
            }
            else if (definition.ValueType == SettingValueType.Uri)
            {
                <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="url" value="@editorValue" disabled />
            }
            else if (definition.ValueType is SettingValueType.LongString or SettingValueType.Html or SettingValueType.EmailTemplate)
            {
                <textarea id="@inputId" class="setting-value" name="Changes[@token].Value" rows="4" disabled>@editorValue</textarea>
                @if (definition.ValueType is SettingValueType.Html or SettingValueType.EmailTemplate)
                {
                    <iframe sandbox="" title="Isolated preview for @definition.DisplayName" class="html-preview"></iframe>
                }
            }
            else
            {
                <input id="@inputId" class="setting-value" name="Changes[@token].Value" type="@(definition.IsSensitive ? "password" : "text")" value="@(definition.IsSensitive ? string.Empty : editorValue)" placeholder="@(definition.IsSensitive ? "Enter a new value to replace the existing secret" : null)" autocomplete="@(definition.IsSensitive ? "new-password" : "off")" disabled />
                @if (definition.IsSensitive)
                {
                    <button type="button" class="reveal-secret" aria-controls="@inputId" aria-expanded="false" aria-label="Reveal @definition.DisplayName">Reveal secret</button>
                    <small>Existing values are write-only and cannot be revealed. Enter a complete replacement.</small>
                }
            }
        </div>
        <button type="button" class="edit-setting">Change</button>
        @if (canRemoveOverride)
        {
            <button type="button" class="inherit-setting" hidden="@isRemoveOverride">Use inherited value</button>
        }
        <p class="inheritance-message" hidden>
            @inheritanceMessage
        </p>
        <span class="edit-actions" hidden>
            <button type="button" class="apply-setting">Apply</button>
            <button type="button" class="cancel-setting">Cancel</button>
        </span>
        </div>
    }
    @if (hasDraftOperation && Model.DraftId.HasValue)
    {
        <button type="submit"
                formaction="@Url.Action("RemoveDraftChange", new { draftId = Model.DraftId })"
                name="settingKey"
                value="@definition.Key"
                data-submit-kind="guarded"
                formnovalidate>
            Remove draft change
        </button>
    }
    <details class="technical-details"><summary>Technical details</summary><p>Setting key: <code>@definition.Key</code></p></details>
    </div>
</details>

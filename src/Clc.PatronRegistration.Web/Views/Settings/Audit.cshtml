@model IEnumerable<Clc.PatronRegistration.Web.Settings.SettingsAuditRow>
@{ ViewData["Title"]="Settings audit"; }<h1>Settings audit history</h1><form method="get"><label>Search <input name="search" type="search" /></label><button>Search</button></form><table><thead><tr><th>UTC</th><th>Event</th><th>Scope</th><th>Setting</th><th>Actor</th><th>Result</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TimestampUtc.ToString("u")</td><td>@x.EventType</td><td>@x.TargetOrganizationId / @x.FormCode</td><td>@x.SettingKey</td><td>@x.ActorName</td><td>@(x.Succeeded?"Success":"Failed")</td></tr>}</tbody></table>

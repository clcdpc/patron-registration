@model IEnumerable<Clc.PatronRegistration.Web.Settings.SettingsAuditRow>
@{
    ViewData["Title"] = "Settings audit";
}
<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
<h1>Settings audit history</h1>
<form method="get" class="settings-search">
    <label for="audit-search">Search audit events</label>
    <input id="audit-search" name="search" type="search" />
    <button type="submit">Search</button>
</form>
<table>
    <caption>Registration-settings administration and preview activity</caption>
    <thead>
        <tr>
            <th scope="col">UTC timestamp</th>
            <th scope="col">Actor</th>
            <th scope="col">Event</th>
            <th scope="col">Target</th>
            <th scope="col">Setting</th>
            <th scope="col">Previous</th>
            <th scope="col">New</th>
            <th scope="col">Result</th>
            <th scope="col">Request</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.TimestampUtc.ToString("u")</td>
                <td>@entry.ActorName</td>
                <td>@entry.EventType</td>
                <td>Organization @entry.TargetOrganizationId; library @entry.TargetLibraryId; form @(entry.FormCode.Length == 0 ? "default" : entry.FormCode)</td>
                <td>@entry.SettingKey</td>
                <td>@entry.PreviousValue</td>
                <td>@entry.NewValue</td>
                <td>@(entry.Succeeded ? "Success" : $"Failed: {entry.FailureReason}")</td>
                <td>@entry.CorrelationId<br />@entry.IpAddress</td>
            </tr>
        }
    </tbody>
</table>

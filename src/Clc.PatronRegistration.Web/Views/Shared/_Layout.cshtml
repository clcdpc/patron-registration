@inject ISettingProvider Settings
@inject Clc.PatronRegistration.Web.Settings.RegistrationHeaderImageResolver HeaderImages

@{
    var bodyClass = ViewData["BodyClass"] as string;
    var pageStylesheet = ViewData["PageStylesheet"] as string;
    var headerImage = HeaderImages.Resolve(Settings?.HeaderImageAssetId, Settings?.HeaderImageUrl);
}

<!DOCTYPE html>
<html lang="en">
<head>
    @if (!@Context.IsInjectedForm())
    {
        <meta name="viewport" content="width=device-width, initial-scale=.9">
    }
    
    <title>@(ViewData["Title"] as string ?? "New Library Card Registration")</title>
</head>
<body class="@bodyClass" aria-live="polite">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <div id="regFormContainer">
        @if (!@Context.IsInjectedForm())
        {
            <link rel="stylesheet" href="@this.BuildUrl(Settings.CssFile)" />
            
            if (headerImage?.AssetId is int assetId)
            {
                <img alt="header image containing the library's logo" src="@Url.RouteUrl("RegistrationFormAsset", new { id = assetId })" role="banner" />
            }
            else if (!string.IsNullOrWhiteSpace(headerImage?.LegacyUrl))
            {
                <img alt="header image containing the library's logo" src="@headerImage?.LegacyUrl" role="banner" />
            }
        }
        @if (!string.IsNullOrWhiteSpace(pageStylesheet))
        {
            <link rel="stylesheet" href="@pageStylesheet" asp-append-version="true" />
        }
        @RenderBody()
    </div>

</body>
</html>
